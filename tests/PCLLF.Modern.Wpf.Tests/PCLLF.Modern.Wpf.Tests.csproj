<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>13.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Configurations>Debug;Release;Snapshot</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../modern/PCLCS/PCLCS.Modern.csproj" />
    <ProjectReference Include="../../modern/Presentation/PCLLF.Presentation.Modern.csproj" />
    <!-- The net48 PowerShell acceptance scripts compile these exact C#5 sources too. -->
    <Compile Include="../PCLLF.Windows.Tests/ResourceThumbnailControllerChecks.cs" Link="Acceptance/ResourceThumbnailControllerChecks.cs" />
    <Compile Include="../PCLLF.Windows.Tests/KeybindingControllerChecks.cs" Link="Acceptance/KeybindingControllerChecks.cs" />
  </ItemGroup>
</Project>
