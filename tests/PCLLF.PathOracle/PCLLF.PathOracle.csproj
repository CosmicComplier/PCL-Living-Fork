<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PathOracleSharedAssembly Condition="'$(PathOracleSharedAssembly)' == ''">$(MSBuildThisFileDirectory)../../MeloongCore/Shared/bin/MeloongCore.dll</PathOracleSharedAssembly>
    <PathOracleNewtonsoftAssembly Condition="'$(PathOracleNewtonsoftAssembly)' == ''">$(MSBuildThisFileDirectory)../../Plain Craft Launcher 2/Resources/Newtonsoft.Json.dll</PathOracleNewtonsoftAssembly>
    <ApplicationManifest Condition="'$(ApplicationManifest)' == ''">$(MSBuildThisFileDirectory)../../Plain Craft Launcher 2/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePaths.cs" Link="Production/InstanceResourcePaths.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePathText.cs" Link="Production/InstanceResourcePathText.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePathCompatibility.cs" Link="Production/InstanceResourcePathCompatibility.cs" />
    <Reference Include="MeloongCore"><HintPath>$(PathOracleSharedAssembly)</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(PathOracleNewtonsoftAssembly)</HintPath></Reference>
  </ItemGroup>
</Project>
