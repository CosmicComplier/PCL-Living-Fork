    <Compile Include="../../PCLCS/Minecraft/InstanceKeybindingReader.cs" Link="Production/InstanceKeybindingReader.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceKeybindingView.cs" Link="Production/InstanceKeybindingView.cs" />
    <Compile Include="../../PCLCS/Minecraft/QuickPlayWorldRules.cs" Link="Production/QuickPlayWorldRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/QuickPlayHistory.cs" Link="Production/QuickPlayHistory.cs" />
    <Compile Include="../../PCLCS/Minecraft/QuickPlayFlow.cs" Link="Production/QuickPlayFlow.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceEntryData.cs" Link="Production/InstanceResourceEntryData.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePaths.cs" Link="Production/InstanceResourcePaths.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePathText.cs" Link="Production/InstanceResourcePathText.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePathCompatibility.cs" Link="Production/InstanceResourcePathCompatibility.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceKindRules.cs" Link="Production/InstanceResourceKindRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceNameRules.cs" Link="Production/InstanceResourceNameRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/LegacyPathCharacters.cs" Link="Production/LegacyPathCharacters.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceFileRules.cs" Link="Production/InstanceResourceFileRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePackageRules.cs" Link="Production/InstanceResourcePackageRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceDetailsRules.cs" Link="Production/InstanceResourceDetailsRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceCatalog.cs" Link="Production/InstanceResourceCatalog.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceTransactions.cs" Link="Production/InstanceResourceTransactions.cs" />
    <Compile Include="../../PCLCS/Minecraft/ResourceRecycleFiles.cs" Link="Production/ResourceRecycleFiles.cs" />
    <Compile Include="../../PCLCS/Minecraft/MapDownloadFiles.cs" Link="Production/MapDownloadFiles.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceOnlineFiles.cs" Link="Production/InstanceResourceOnlineFiles.cs" />
    <Compile Include="../../PCLCS/Minecraft/WorldBackupContracts.cs" Link="Production/WorldBackupContracts.cs" />
    <Compile Include="../../PCLCS/Minecraft/WorldBackupEngine.cs" Link="Production/WorldBackupEngine.cs" />
    <Compile Include="../../PCLCS/Minecraft/WorldBackupEngine.Restore.cs" Link="Production/WorldBackupEngine.Restore.cs" />
    <Compile Include="../../PCLCS/Minecraft/WorldBackupWorkflow.cs" Link="Production/WorldBackupWorkflow.cs" />
    <Compile Include="../../PCLCS/Minecraft/EnvironmentHistoryContracts.cs" Link="Production/EnvironmentHistoryContracts.cs" />
    <Compile Include="../../PCLCS/Minecraft/EnvironmentHistoryEngine.cs" Link="Production/EnvironmentHistoryEngine.cs" />
    <Compile Include="../../PCLCS/Minecraft/EnvironmentHistoryEngine.Restore.cs" Link="Production/EnvironmentHistoryEngine.Restore.cs" />
    <Compile Include="../../PCLCS/Minecraft/EnvironmentHistoryWorkflow.cs" Link="Production/EnvironmentHistoryWorkflow.cs" />
    <Compile Include="../../PCLCS/Minecraft/RecentEnvironmentChanges.cs" Link="Production/RecentEnvironmentChanges.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceCloneContracts.cs" Link="Production/InstanceCloneContracts.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceCloneEngine.cs" Link="Production/InstanceCloneEngine.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceCloneEngine.Migration.cs" Link="Production/InstanceCloneEngine.Migration.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceCloneWorkflow.cs" Link="Production/InstanceCloneWorkflow.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceCloneGroupsEngine.cs" Link="Production/InstanceCloneGroupsEngine.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceCloneExportIsolation.cs" Link="Production/InstanceCloneExportIsolation.cs" />
    <Compile Include="../../PCLCS/Minecraft/ModDependencyInspection.Contracts.cs" Link="Production/ModDependencyInspection.Contracts.cs" />
    <Compile Include="../../PCLCS/Minecraft/ModDependencyInspection.Archives.cs" Link="Production/ModDependencyInspection.Archives.cs" />
    <Compile Include="../../PCLCS/Minecraft/ModDependencyInspection.Resolution.cs" Link="Production/ModDependencyInspection.Resolution.cs" />
    <Compile Include="../../PCLCS/Minecraft/ModDependencyVersions.cs" Link="Production/ModDependencyVersions.cs" />
    <!-- Keep the real Minecraft/component/loader models and pinned Shared helpers. -->
    <Compile Include="../../PCLCS/Constants.cs" Link="Production/Constants.cs" />
    <Compile Include="../../PCLCS/Minecraft/McVersion.cs" Link="Production/McVersion.cs" />
    <Compile Include="../../PCLCS/Minecraft/McInstallManifest.cs" Link="Production/McInstallManifest.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePackMetadataCompatibility.cs" Link="Production/InstanceResourcePackMetadataCompatibility.cs" />
    <Compile Include="../../PCLCS/Minecraft/LegacyPackMetadataNumberParser.cs" Link="Production/LegacyPackMetadataNumberParser.cs" />
    <Compile Include="../../PCLCS/Minecraft/LegacyPackMetadataNumberFormatting.cs" Link="Production/LegacyPackMetadataNumberFormatting.cs" />
    <Reference Include="Newtonsoft.Json">
      <!-- Match the DLL already used by LF; do not change persisted JSON through a new serializer. -->
      <HintPath>../../Plain Craft Launcher 2/Resources/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <ProjectReference Include="../../MeloongCore/Shared/MeloongCore.csproj" />
    <!-- Suppress Shared's transitive JSON assets here so the original LF DLL
         remains the compile and CopyLocal input instead of NuGet's net6 build. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Newtonsoft.Json" />
    <Using Include="Newtonsoft.Json.Linq" />
    <Using Include="MeloongCore" />
    <Using Include="MeloongCore.Extensions" />
    <Using Include="System.Text.RegularExpressions" />
  </ItemGroup>
</Project>
