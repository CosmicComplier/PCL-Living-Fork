<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Run production rules without the launcher's Windows/WPF dependencies. -->
    <Compile Include="../../PCLCS/Minecraft/WorldMetadataReader.cs" Link="Production/WorldMetadataReader.cs" />
    <Compile Include="../../PCLCS/Minecraft/WorldMetadataFiles.cs" Link="Production/WorldMetadataFiles.cs" />
    <Compile Include="../../PCLCS/Minecraft/LocalGameDataStore.cs" Link="Production/LocalGameDataStore.cs" />
    <Compile Include="../../PCLCS/Minecraft/PersonalOptionsRules.cs" Link="Production/PersonalOptionsRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/PersonalOptionsFiles.cs" Link="Production/PersonalOptionsFiles.cs" />
    <Compile Include="../../PCLCS/Minecraft/PersonalOptionsFlow.cs" Link="Production/PersonalOptionsFlow.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceKeybindingFiles.cs" Link="Production/InstanceKeybindingFiles.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceKeybindingReader.cs" Link="Production/InstanceKeybindingReader.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceKeybindingView.cs" Link="Production/InstanceKeybindingView.cs" />
    <Compile Include="../../PCLCS/Minecraft/QuickPlayWorldRules.cs" Link="Production/QuickPlayWorldRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/QuickPlayHistory.cs" Link="Production/QuickPlayHistory.cs" />
    <Compile Include="../../PCLCS/Minecraft/QuickPlayFlow.cs" Link="Production/QuickPlayFlow.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceEntryData.cs" Link="Production/InstanceResourceEntryData.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePaths.cs" Link="Production/InstanceResourcePaths.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePathText.cs" Link="Production/InstanceResourcePathText.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePathCompatibility.cs" Link="Production/InstanceResourcePathCompatibility.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceKindRules.cs" Link="Production/InstanceResourceKindRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceNameRules.cs" Link="Production/InstanceResourceNameRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/LegacyPathCharacters.cs" Link="Production/LegacyPathCharacters.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceFileRules.cs" Link="Production/InstanceResourceFileRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePackageRules.cs" Link="Production/InstanceResourcePackageRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourceDetailsRules.cs" Link="Production/InstanceResourceDetailsRules.cs" />
    <Compile Include="../../PCLCS/Minecraft/InstanceResourcePackMetadataCompatibility.cs" Link="Production/InstanceResourcePackMetadataCompatibility.cs" />
    <Compile Include="../../PCLCS/Minecraft/LegacyPackMetadataNumberParser.cs" Link="Production/LegacyPackMetadataNumberParser.cs" />
    <Compile Include="../../PCLCS/Minecraft/LegacyPackMetadataNumberFormatting.cs" Link="Production/LegacyPackMetadataNumberFormatting.cs" />
    <Reference Include="Newtonsoft.Json">
      <!-- Match the DLL already used by LF; do not change persisted JSON through a new serializer. -->
      <HintPath>../../Plain Craft Launcher 2/Resources/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
