<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL"
    x:Class="PCL.PageInstancePackUpdate" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Title="整合包更新" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image x:Name="ImgPack" Width="72" Height="72" Margin="0,0,20,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LabName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="整合包"/>
                            <TextBlock x:Name="LabVersion" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,5" Text="正在读取…" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LabSource" Foreground="{DynamicResource ColorBrushGray3}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,20,-15,0">
                        <local:MyButton x:Name="BtnOnline" Text="检查更新" Width="140" Height="35" Margin="0,0,15,0" ColorType="Highlight"/>
                        <local:MyButton x:Name="BtnLocal" Text="从文件更新" Width="140" Height="35" Margin="0,0,15,0"/>
                        <local:MyButton x:Name="BtnBackups" Text="更新备份" Width="140" Height="35" Margin="0,0,15,0"/>
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyHint x:Name="HintState" Margin="0,0,0,15" Text="选择新版本后，可以预览文件变更并检查模组兼容性。"/>
            <local:MyCard Title="搜索版本" Margin="0,0,0,15">
                <local:MySearchBox x:Name="TextSearchVersion" Margin="20,40,20,18" HintText="搜索版本名称或 Minecraft 版本" />
            </local:MyCard>
            <local:MyCard Title="版本列表" Margin="0,0,0,15">
                <StackPanel Margin="15,40,15,15">
                    <TextBlock x:Name="LabListStatus" Margin="5,0,5,10" Foreground="{DynamicResource ColorBrushGray3}" TextWrapping="Wrap" />
                    <StackPanel x:Name="PanVersions" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
