<local:MyPageLeft x:Class="PCL.PageSpeedLeft"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PCL"
      mc:Ignorable="d"
      d:DesignHeight="550" Width="200" HorizontalAlignment="Left">
    <Grid.Resources>
        <ResourceDictionary>
            <Style TargetType="StackPanel" x:Key="Metric">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,4" />
            </Style>
            <Style TargetType="TextBlock" x:Key="MetricTitle">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
            </Style>
            <Style TargetType="TextBlock" x:Key="MetricValue">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="20" />
            </Style>
            <Style TargetType="TextBlock" x:Key="Split">
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Height" Value="2" />
                <Setter Property="Margin" Value="25,7" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                            <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="0"/>
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.02"/>
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.98"/>
                            <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Grid.Resources>
    <Grid Name="PanMetrics" Margin="0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Style="{StaticResource Metric}">
            <TextBlock Text="总进度" Style="{StaticResource MetricTitle}" />
            <TextBlock Style="{StaticResource Split}" />
            <TextBlock Text="00.00 %" Name="LabProgress" Style="{StaticResource MetricValue}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Style="{StaticResource Metric}">
            <TextBlock Text="下载速度" Style="{StaticResource MetricTitle}" />
            <TextBlock Style="{StaticResource Split}" />
            <TextBlock Text="0 B/s" Name="LabSpeed" Style="{StaticResource MetricValue}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Style="{StaticResource Metric}" ToolTip="启动器文件任务的实际读写字节统计，包含系统缓存。">
            <TextBlock Text="读取速度" Style="{StaticResource MetricTitle}" />
            <TextBlock Style="{StaticResource Split}" />
            <TextBlock Text="0 B/s" Name="LabReadSpeed" Style="{StaticResource MetricValue}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Style="{StaticResource Metric}" ToolTip="启动器文件任务的实际读写字节统计，包含系统缓存。">
            <TextBlock Text="写入速度" Style="{StaticResource MetricTitle}" />
            <TextBlock Style="{StaticResource Split}" />
            <TextBlock Text="0 B/s" Name="LabWriteSpeed" Style="{StaticResource MetricValue}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Style="{StaticResource Metric}">
            <TextBlock Text="剩余文件" Style="{StaticResource MetricTitle}" />
            <TextBlock Style="{StaticResource Split}" />
            <TextBlock Text="0" Name="LabFile" Style="{StaticResource MetricValue}" />
        </StackPanel>
        <StackPanel Grid.Row="5" Name="PanThread" Style="{StaticResource Metric}">
            <TextBlock Text="剩余线程" Style="{StaticResource MetricTitle}" />
            <TextBlock Style="{StaticResource Split}" />
            <TextBlock Text="0 / 0" Name="LabThread" Style="{StaticResource MetricValue}" />
        </StackPanel>
    </Grid>
</local:MyPageLeft>
