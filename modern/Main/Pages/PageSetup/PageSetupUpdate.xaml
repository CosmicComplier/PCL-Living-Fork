<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL"
    x:Class="PCL.PageSetupUpdate" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard x:Name="CardLauncherUpdate" Title="启动器更新" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <Grid x:Name="HeaderGrid">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel x:Name="PanIdentity" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="ImgLauncher" Width="82" Height="82" Margin="0,0,20,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PCL Living Fork" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="LabCurrentVersion" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBlock x:Name="LabBuildStatus" FontSize="13" Foreground="{DynamicResource ColorBrushGray3}"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid x:Name="PanUpdateOptions" Grid.Column="2" Width="320" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="9"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                            <TextBlock Text="更新源" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <local:MyComboBox x:Name="ComboSource" Grid.Column="1">
                                <local:MyComboBoxItem Content="CNB（国内）"/><local:MyComboBoxItem Content="GitHub Releases"/>
                            </local:MyComboBox>
                            <TextBlock Text="更新通道" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <local:MyComboBox x:Name="ComboChannel" Grid.Row="2" Grid.Column="1" ToolTip="选择接收的启动器发布类型。开启预发布更新前需要确认。">
                                <local:MyComboBoxItem Content="仅接收正式版"/><local:MyComboBoxItem Content="接收正式版和预发布版"/>
                            </local:MyComboBox>
                        </Grid>
                        <StackPanel x:Name="PanUpdateActions" Grid.Column="2" Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <local:MyButton x:Name="BtnRefresh" MinWidth="140" Height="35" Text="检查更新" ColorType="Highlight" Padding="13,0" Margin="0,0,16,0"/>
                            <local:MyButton x:Name="BtnReleasePage" MinWidth="140" Height="35" Text="打开发布页" Padding="13,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MySearchBox x:Name="TextSearchVersion" HintText="搜索启动器版本号 / 发布名称" Margin="0,0,0,15"/>
            <local:MyCard x:Name="CardVersions" Title="版本列表" Margin="0,0,0,15">
                <StackPanel Margin="20,40,18,15">
                    <TextBlock x:Name="LabResultCount" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,0,0,12"/>
                    <local:MyLoading x:Name="Loading" Text="正在检查更新" Margin="0,4,0,12" Visibility="Collapsed"/>
                    <local:MyHint x:Name="HintStatus" Theme="Blue" Text="检查当前通道的可用版本。" Margin="0,0,0,12"/>
                    <StackPanel x:Name="PanVersions"/>
                    <TextBlock x:Name="LabNoResults" Text="没有找到匹配的版本，试试其他版本号或发布名称。" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}" Margin="4,12,4,14" Visibility="Collapsed"/>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
