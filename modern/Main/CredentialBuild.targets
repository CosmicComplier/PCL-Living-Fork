<Project>
  <!-- Imported by the modern Main project only; no property override reaches Core/PF. -->
  <PropertyGroup Condition="'$(CredentialIntermediateOutputPath)' != ''">
    <IntermediateOutputPath>$(CredentialIntermediateOutputPath)</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(GeneratedCredentialSource)' != ''">
    <Compile Include="$(GeneratedCredentialSource)" Link="BuildOnly/BuildCredentials.g.cs" />
  </ItemGroup>
  <Target Name="ValidateGeneratedCredentialSource" BeforeTargets="CoreCompile" Condition="'$(GeneratedCredentialSource)' != ''">
    <Error Condition="!Exists('$(GeneratedCredentialSource)')" Text="The generated C# credential source is missing." />
  </Target>
</Project>
