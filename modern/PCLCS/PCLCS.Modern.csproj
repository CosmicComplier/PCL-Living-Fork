<Project Sdk="Microsoft.NET.Sdk">
  <!-- LF-owned modern build of the existing PCLCS source tree, under ../../LICENCE.
       Shared remains the LF-pinned netstandard2.0 submodule at
       c774ae4c85fd94e0eaa171db21e78a65870df19b (../../MeloongCore/LICENSE.txt).
       No CE project or implementation is copied into this build. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <AssemblyName>PCLCS</AssemblyName>
    <RootNamespace>PCLCS</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release;Snapshot</Configurations>
    <Deterministic>true</Deterministic>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../PCLCS/**/*.cs" Exclude="../../PCLCS/**/bin/**;../../PCLCS/**/obj/**"
      Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../PCLCS/Launch/JavaWrapper.jar" LogicalName="Launch\JavaWrapper.jar" />
    <EmbeddedResource Include="../../PCLCS/Launch/LwjglUnsafeAgent.jar" LogicalName="Launch\LwjglUnsafeAgent.jar" />
    <EmbeddedResource Include="../../PCLCS/Resource/WikiEntries.txt" LogicalName="Resource\WikiEntries.txt" />
    <EmbeddedResource Include="../../PCLCS/Minecraft/OptifineHashes.json" LogicalName="Minecraft\OptiFineHashes.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <Reference Include="Imazen.WebP">
      <HintPath>../../Plain Craft Launcher 2/Resources/Imazen.WebP.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../../MeloongCore/Shared/MeloongCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the plain SDK implicit imports removed by the WPF SDK. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="System.Collections" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Text" />
    <Using Include="System.Text.RegularExpressions" />
    <Using Include="System.Net" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="Newtonsoft.Json" />
    <Using Include="Newtonsoft.Json.Linq" />
    <Using Include="MeloongCore" />
    <Using Include="MeloongCore.Extensions" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);SNAPSHOT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Snapshot|AnyCPU'">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
