<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same LF controls and XAML as ../../presentation/PCLLF.Presentation.csproj.
       The modern animation host remains a separate migration boundary; this
       project supplies no replacement or inert implementation of LF animations. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <AssemblyName>PCLLF.Presentation</AssemblyName>
    <RootNamespace>PCLLF.Presentation</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Configurations>Debug;Release;Snapshot</Configurations>
    <Deterministic>true</Deterministic>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../presentation/Controls/**/*.cs"
      Exclude="../../presentation/**/bin/**;../../presentation/**/obj/**"
      Link="Controls/%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="../../presentation/Controls/*.xaml" Link="Controls/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);SNAPSHOT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Snapshot|AnyCPU'">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
